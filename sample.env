# ==============================================================
# TELEGRAM BOT CONFIGURATION (.env)
# ==============================================================

# 1. Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. Telegram Admin User IDs (Comma-separated numbers only, find via @userinfobot)
ADMIN_IDS=123456789,987654321

# 3. Payment Accounts
UPI_ID=merchant@okaxis
ESEWA_ID=9801234567

# 4. Exchange Limits (INR/NPR)
MIN_EXCHANGE_AMOUNT=100
MAX_EXCHANGE_AMOUNT=100000
SERVICE_FEE_PERCENTAGE=2.5

# 5. Features
ENABLE_REFERRAL=True
REFERRAL_BONUS_PERCENT=1.0
ENABLE_DYNAMIC_QR=True
ANTI_SPAM_LIMIT=8
ANTI_SPAM_WINDOW=3600

# 6. Telegram Log Channel ID (Optional, e.g. -1001234567890)
LOG_CHANNEL_ID=0

# 7. Images / Banners (Optional)
BANNER_IMAGE_URL=https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?w=1200&q=80
